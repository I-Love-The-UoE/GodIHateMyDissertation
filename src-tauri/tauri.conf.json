{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GodIHateMyDissertation",
  "version": "0.1.0",
  "identifier": "dev.realistik.gihmd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GodIHateMyDissertation",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: blob:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/builds/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
